<t tx="ekr.20261116100829.319">def toPythonIndexRowCol(self, index: int) -&gt; tuple[int, int]:
    te = self.widget
    doc = te.document()
    s = self.getAllText()
    bl = doc.findBlock(pythonIndexToQt(s, index))
    row = bl.blockNumber()
    col = index - qtIndexToPython(s, bl.position())
    return row, col

