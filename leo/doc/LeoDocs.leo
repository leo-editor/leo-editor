<t tx="ekr.20261116100829.270">def runRuffFormat(self, contents: str, root: Position, filename: str) -&gt; bool:
    """
    Run ruff format on the selected position.
    Return True if all went well.
    """
    c = self.c
    old_p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    efc = g.app.externalFilesController
    if not os.path.exists(filename):
        return False

    # PR #5050: Capture old data *before* the beautify.
    w_old_ins = w.getInsertPoint()
    w_old_sel = w.getSelectionRange()
    w_old_text = w.getAllText()

    # Beautify.
    results = c.beautify_with_ruff(contents, root, filename)
    efc.set_time(filename)  # Always suppress the reload prompt.
    if contents == results:
        return True

    # Careful: refresh-from-disk clears the u.beads!
    g.es_print(f"beautified: {g.shortFileName(filename)}", color='blue')
    c.refreshFromDisk(root, redraw_flag=False)
    c.contractAllHeadlines()
    c.redraw(old_p)  # Required.

    # PR #5050: only changes to the current node (c.p.b) are undoable.
    if w_old_text != c.p.b:
        u.type_text(old_p, oldText=w_old_text, oldIns=w_old_ins, oldSel=w_old_sel, w=w)
        c.redraw(old_p)  # Required.
    return True

</t>
<t tx="ekr.20261116100829.271">@g.commander_command('refresh-from-disk')
def refreshFromDisk(
    self: Self,
    p: Position | None = None,
    event: LeoKeyEvent | None = None,
    *,
    redraw_flag: bool = True,
    silent: bool = True,  # Not used.
) -&gt; None:
    """
    Refresh an @&lt;file&gt; node from disk.

    This command is not undoable directly, but callers may make (parts of it) undoable.
    """
    c = self
    at = c.atFileCommands
    u = c.undoer  # PR #5025
    if not p:
        p = c.p

    if not p.isAnyAtFileNode():
        g.warning(f"not an @&lt;file&gt; node: {p.h!r}")
        g.trace(g.callers())
        return

    at.changed_roots = []  # #4385.
    full_path = c.fullPath(p)
    if os.path.isdir(full_path):
        g.warning(f"not a file: {full_path!r}")
        return

    c.nodeConflictList = []
    c.recreateGnxDict()

    # #4875: Always clear the cached mod time *before* reading the file.
    c.mod_time_cache.pop(p.v.gnx, None)

    at.readFileAtPosition(p)  # Leo 6.8.6.

    # #4385: Handle updated @clean nodes.
    if update_p := at.clone_all_changed_vnodes():
        # Set the current position during initial redraws.
        c.db['current_position'] = ','.join([str(z) for z in update_p.archivedPosition()])
        update_p.expand()
        c.selectPosition(update_p)
    else:
        update_p = p  # #4495: Do *not* change the position!

    # Create the 'Recovered Nodes' tree.
    at.changed_roots = []
    c.fileCommands.handleNodeConflicts()
    c.setChanged()
    # Select a valid position!
    c.p = update_p if c.positionExists(update_p) else c.rootPosition()
    if redraw_flag:
        c.redraw(update_p)
    u.clearAndWarn('refresh-from-disk')


</t>
<t tx="ekr.20261116100829.272">@cmd('backward-delete-char')
def backwardDeleteCharacter(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Delete the character to the left of the cursor."""
    c = self.c
    p = c.p
    u = c.undoer
    # This method *must* work everywhere.
    w = event.w if event else c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    wname = c.widget_name(w)
    ins = w.getInsertPoint()
    i, j = oldSel = w.getSelectionRange()
    if wname.startswith('body'):
        tab_width = c.getTabWidth(c.p)
        if i != j:
            w.delete(i, j)
            w.setSelectionRange(i, i, insert=i)
        elif i == 0:
            pass
        elif tab_width &gt; 0:
            w.delete(ins - 1)
            w.setSelectionRange(ins - 1, ins - 1, insert=ins - 1)
        else:
            # backspace with negative tab_width
            s = prev = w.getAllText()
            ins = w.getInsertPoint()
            i, j = g.getLine(s, ins)
            s = prev = s[i:ins]
            n = len(prev)
            abs_width = abs(tab_width)
            # Delete up to this many spaces.
            n2 = (n % abs_width) or abs_width
            n2 = min(n, n2)
            count = 0
            while n2 &gt; 0:
                n2 -= 1
                ch = prev[n - count - 1]
                if ch != ' ':
                    break
                else:
                    count += 1
            # Make sure we actually delete something.
            i = ins - (max(1, count))
            w.delete(i, ins)
            w.setSelectionRange(i, i, insert=i)
        # PR #5050: *always* call u.type_text!
        u.type_text(p, oldIns=i, oldSel=oldSel, oldText=p.b, w=w)
        return
    # No *direct* undo in this widget.
    # Undo in headlines is handled indirectly.
    s = w.getAllText()
    # Delete something if we can.
    if i != j:
        j = max(i, min(j, len(s)))
        w.delete(i, j)
        w.setSelectionRange(i, i, insert=i)
    elif ins != 0:
        # Do nothing at the start of the headline.
        w.delete(ins - 1)
        ins = ins - 1
        w.setSelectionRange(ins, ins, insert=ins)

</t>
<t tx="ekr.20261116100829.273">def idle_check_commander(self, c: Cmdr) -&gt; None:
    """
    Check all external files corresponding to @&lt;file&gt; nodes in c for
    changes.
    """
    # #1240: Check the .leo file itself.
    self.idle_check_leo_file(c)

    # #1100: always scan the entire file for @&lt;file&gt; nodes.
    # #1134: Nested @&lt;file&gt; nodes are no longer valid, but this will do no harm.
    changed = False
    state = 'no'
    changed_roots: set[str] = set()
    old_p = c.p
    for p in c.all_unique_positions():
        if not p.isAnyAtFileNode():
            continue
        path = c.fullPath(p)
        if not self.has_changed(path):
            continue
        # Prevent further checks for path.
        self.set_time(path)
        self.checksum_d[path] = self.checksum(path)
        # Check file.
        if (
            p.isAtAsisFileNode()
            or p.isAtEditNode()  # PR #5050
            or p.isAtNoSentFileNode()
        ):
            # #1081: issue a warning.
            self.warn(c, path, p=p)
            continue
        # #4117: Always update .ipynb files.
        if p.isAtJupytextNode():
            g.app.jupytextManager.update(c, p, path)
            continue
        if state in ('yes', 'no'):
            state = self.ask(c, path, p=p)
        if state in ('yes', 'yes-all'):
            changed = True
            c.refreshFromDisk(p, silent=False)
            # #4565: set all clones in p's subtree dirty.
            for p2 in p.subtree():
                if p2.v.isCloned():
                    p2.v.setDirty()
            # #4565 and PR #5001: set all ancestor file nodes dirty and redraw.
            p.setDirty()  # Calls p.v.setAllAncestorAtFileNodesDirty().
            changed_roots.add(p.h)
    if not changed:
        return
    # #4570: Write all update messages here, and only here.
    if not g.unitTesting:
        for s in sorted(list(changed_roots)):
            g.es_print('update:', s, color='blue')
    new_p = old_p if c.positionExists(old_p) else c.p  # PR #5001
    c.redraw(new_p)

