<t tx="ekr.20261116100828.181">def check_file(self, fn: str, root: Position) -&gt; None:
    """Run ruff on one file."""
    c = self.c
    if not ruff:
        g.print_unique_message('install ruff with `pip install ruff`')
        return
    command = f"{sys.executable} -m ruff check --output-format=concise {fn}"
    bpm = g.app.backgroundProcessManager
    bpm.start_process(c, command, fn=fn, kind='ruff')

