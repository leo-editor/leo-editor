<t tx="ekr.20261116100828.1211">@cmd('kill-sentence')
def killSentence(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Kill the sentence containing the cursor."""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    s = w.getAllText()
    ins = w.getInsertPoint()
    i = s.find('.', ins)
    if i == -1:
        return
    with u.change_node(p, 'kill-sentence'):
        i2 = s.rfind('.', 0, ins) + 1
        self.killHelper(event, i2, i + 1, w)
        p.v.b = w.getAllText()
        c.k.resetLabel()

