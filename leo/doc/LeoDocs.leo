<t tx="ekr.20261116100828.398">def _ensure_jupytext() -&gt; bool:
    """Import jupytext on first call. Return True if available."""
    global jupytext, has_jupytext
    if has_jupytext:
        return True
    if jupytext is not None:
        return False  # already tried and failed
    try:
        import jupytext as _jt

        jupytext = _jt
        has_jupytext = True
        return True
    except Exception:
        jupytext = False
        g.missing('jupytext', tag='leoJupytext.py')
        return False


