name = c.widget_name(w)
oldIns = w.getInsertPoint() if name.startswith('body') else 0  # PR #4812
oldSel = w.getSelectionRange() if name.startswith('body') else (oldIns, oldIns)  # PR #4812
oldText = p.b if name.startswith('body') else ''
