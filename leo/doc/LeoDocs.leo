<t tx="ekr.20261116100828.1107">def change_selection(self, p: Position) -&gt; bool:
    """Replace selection with self.change_text."""
    c = self.c
    u = c.undoer
    wrapper = c.frame.body and c.frame.body.wrapper
    w = c.headline_wrapper(p) if self.in_headline else wrapper
    if not w:  # pragma: no cover
        self.in_headline = False
        w = wrapper
    if not w:  # pragma: no cover
        return False
    assert w
    start, end = old_sel = w.getSelectionRange()
    if start &gt; end:  # pragma: no cover
        start, end = end, start
    if start == end:  # pragma: no cover
        g.es("no text selected")
        return False
    start, end = old_sel
    change_text = self.change_text
    # Perform regex substitutions of \1, \2, ...\9 in the change text.
    if self.pattern_match and self.match_obj:
        groups = self.match_obj.groups()
        if groups:
            change_text = self.make_regex_subs(change_text, groups)
    change_text = self.replace_back_slashes(change_text)

    with u.change_node(p, 'change-selection'):
        # Update both the gui widget and the work "widget"
        new_ins = start if self.reverse else start + len(change_text)
        if start != end:
            w.delete(start, end)
        w.insert(start, change_text)
        w.setInsertPoint(new_ins)
        self.work_s = w.getAllText()  # #2220.
        self.work_sel = (new_ins, new_ins, new_ins)
        # Update the selection for the next match.
        w.setSelectionRange(start, start + len(change_text))
        c.widgetWantsFocus(w)
        # No redraws here: they would destroy the headline selection.
        if self.in_headline:
            # #2220: Let onHeadChanged handle undo, etc.
            c.frame.tree.onHeadChanged(p, 'change-headline')
            # w will change after a redraw.
            u.redraw_after_head_changed()  # Required
            w = c.headline_wrapper(p)
            if g.isTextWrapper(w):
                # find-next and find-prev work regardless of insert point.
                assert w
                w.setSelectionRange(start, start + len(change_text))
            if self.mark_changes and not p.isMarked():  # pragma: no cover
                p.setMarked()
                p.setDirty()
            return True
        p.v.b = w.getAllText()
        if self.mark_changes and not p.isMarked():  # pragma: no cover
            p.setMarked()
            p.setDirty()
        return True

</t>
<t tx="ekr.20261116100828.1108">@frame_cmd('cut-text')
def cutText(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Invoked from the mini-buffer and from shortcuts."""
    if not event:
        return
    c = self.c
    p = c.p
    u = c.undoer
    w = event.w
    if not g.isTextWrapper(w):
        return
    # Set the clipboard text.
    i, j = w.getSelectionRange()
    if i == j:
        oldText = w.getAllText()
        old_ins = w.getInsertPoint()
        i, j = g.getLine(oldText, old_ins)
    s = w.get(i, j)
    s = s.replace('\r\n', '\n').replace('\r', '\n')  # 3759.
    g.app.gui.replaceClipboardWith(s)
    if c.widget_name(w).startswith('body'):
        with u.change_node(p, 'cut-text'):
            w.delete(i, j)
            p.v.b = w.getAllText()
            w.see(i)
    else:
        w.delete(i, j)
        w.see(i)

    # Otherwise, the headline has not yet offcially changed.

OnCutFromMenu = cutText

</t>
<t tx="ekr.20261116100828.1109">@frame_cmd('paste-text')
def pasteText(self, event: LeoKeyEvent | None = None, middleButton: bool = False) -&gt; None:
    """
    Paste the clipboard into a widget.
    If middleButton is True, support x-windows middle-mouse-button easter-egg.
    """
    if not event:
        return
    c = self.c
    p = c.p
    u = c.undoer
    w = event.w
    if not g.isTextWrapper(w):
        return
    wname = c.widget_name(w)

    # Compute the required data.
    i, j = w.getSelectionRange()
    s = g.app.gui.getTextFromClipboard()
    s = g.checkUnicode(s)
    s = s.replace('\r\n', '\n').replace('\r', '\n')  # 3759.
    new_ins = i + len(s)

    # #2593: Replace link patterns with html links.
    if wname.startswith('log'):
        if c.frame.log.put_html_links(s):
            return  # create_html_links has done all the work.

    def update_w() -&gt; None:
        if i != j:
            w.delete(i, j)
        w.insert(i, s)
        w.see(new_ins + 2)
        w.setSelectionRange(new_ins, new_ins, insert=new_ins)

    if wname.startswith('body'):
        with u.change_node(p, 'paste-text'):
            update_w()
            p.v.b = w.getAllText()
            w.see(w.getInsertPoint())
    else:
        if hasattr(w, 'getXScrollPosition'):
            x_pos = w.getXScrollPosition()
        update_w()
        if hasattr(w, 'getXScrollPosition'):
            w.setXScrollPosition(x_pos)

OnPasteFromMenu = pasteText

</t>
