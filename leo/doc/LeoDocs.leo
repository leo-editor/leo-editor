<t tx="ekr.20261116100828.928">def dragCloneToNthChildOf(self, p: Position, parent: Position, n: int) -&gt; None:
    c = self
    u = c.undoer
    c.endEditing()
    with u.change_outline('c.dragCloneToNthChildOf'):
        clone = p.clone()
        if (
            c.checkDrag(p, parent) and
            c.checkMoveWithParentWithWarning(clone, parent, True)
        ):  # fmt: skip
            clone.setDirty()
            clone.moveToNthChildOf(parent, n)
            clone.setDirty()
            p = clone
        else:
            clone.doDelete(newNode=p)
        c.p = clone

</t>
<t tx="ekr.20261116100828.929">def dragCloneAfter(self, p: Position, after: Position) -&gt; None:
    c = self
    u = c.undoer
    c.endEditing()
    with u.change_outline('c.dragCloneAfter'):
        clone = p.clone()
        if (
            c.checkDrag(p, after) and
            c.checkMoveWithParentWithWarning(clone, after.parent(), True)
        ):  # fmt: skip
            clone.setDirty()
            clone.moveAfter(after)
            clone.setDirty()
            p = clone
        else:
            # Destroys clone and makes p the current node.
            clone.doDelete(newNode=p)
        c.p = p

