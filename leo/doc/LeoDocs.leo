<t tx="ekr.20261116100828.1363">def replace_selection(self, i: int, j: int, s: str) -&gt; None:
    """Undoably replace w[i:j] by s."""
    c = self.c
    p = c.p
    u = c.undoer
    w = self.w
    if self.in_head:
        # #5021: Do *not* use u.change_node in headlines!
        w.delete(i, j)
        w.insert(i, s)
        return
    with u.change_node(p, 'replace-selection'):
        w.delete(i, j)
        w.insert(i, s)
        p.v.b = w.getAllText()

