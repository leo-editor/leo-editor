<t tx="ekr.20261116100828.1424">def getSelectionRange(self, sort: bool = True) -&gt; tuple[int, int]:
    """Return the selected range of the widget."""
    sel = self.sel

    # Check if sel contains None values (can be set by leoFind.py's 'save' and 'restore' methods).
    if len(sel) == 2 and (sel[0] is None or sel[1] is None):
        return 0, 0

    if len(sel) == 2 and sel[0] &gt;= 0 and sel[1] &gt;= 0:
        i, j = sel
        if sort and i &gt; j:
            sel = j, i  # Bug fix: 10/5/07
        return sel
    i = self.ins
    return i, i

