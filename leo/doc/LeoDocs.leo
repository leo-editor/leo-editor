<t tx="ekr.20261116100828.52">def readOneAtAsisNode(self, p: Position) -&gt; None:  # pragma: no cover
    """Read one @asis node. Used only by refresh-from-disk"""
    at, c = self, self.c
    fn = c.fullPath(p)
    _, ext = g.os_path_splitext(fn)
    # Remember the full fileName.
    at.rememberReadPath(fn, p)
    s, e = g.readFileIntoString(fn, kind='@edit')
    if s is None:
        return
    encoding = e or 'utf-8'
    # Delete all children.
    while p.hasChildren():
        p.firstChild().doDelete()
    old_body = p.b
    p.b = g.toUnicode(s, encoding=encoding, reportErrors=True)
    if not c.isChanged() and p.b != old_body:
        c.setChanged()
    g.doHook('after-reading-external-file', c=c, p=p)

