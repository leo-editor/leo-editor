<t tx="ekr.20261116100828.3091">@g.commander_command('unmark-all')
def unmarkAll(self: Cmdr, event: LeoKeyEvent | None = None) -&gt; None:
    """Unmark all nodes in the entire outline."""
    c = self
    current = c.p
    u = c.undoer
    if not current:
        return
    c.endEditing()
    changed = False
    with u.change_outline('unmark-all'):
        for p in c.all_unique_positions():
            if p.isMarked():
                # c.clearMarked(p) # Very slow: calls a hook.
                p.v.clearMarked()
                p.setDirty()
                changed = True
        if changed:
            g.doHook("clear-all-marks", c=c, p=p)


