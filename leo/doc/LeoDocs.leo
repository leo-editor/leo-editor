<t tx="ekr.20261116100829.74">def test_undoing_insert_node_restores_previous_node_s_body_text(self):
    c = self.c
    u = c.undoer
    h = 'Test headline abc'
    p = c.rootPosition().insertAfter()
    p.h = h
    c.selectPosition(p)
    body = 'This is a test'
    c.setBodyString(p, body)
    self.assertEqual(p.b, body)
    c.insertHeadline()
    for _i in range(3):
        u.undo()
        self.assertEqual(p.b, body)
        u.redo()

