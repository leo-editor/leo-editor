<t tx="ekr.20261116100828.1491">def test_inner_search_plain(self):
    x = self.x

    def test(table, table_name, nocase, word):
        test_n = 0
        for pattern, s, i, j, expected, expected_i, expected_j in table:
            test_n += 1
            if j == -1:
                j = len(s)
            got_i, got_j = x._inner_search_plain(s, i, j, pattern, nocase=nocase, word=word)
            got = s[got_i:got_j]
            assert expected == got and got_i == expected_i and got_j == expected_j, (
                f"\n     table: {table_name}"
                f"\n    i test: {test_n}"
                f"\n   pattern: {pattern!r}"
                f"\n         s: {s!r}"
                f"\n  expected: {expected!r}"
                f"\n       got: {got!r}"
                f"\nexpected i: {expected_i}"
                f"\n     got i: {got_i}"
                f"\nexpected j: {expected_j}"
                f"\n     got j: {got_j}"
            )

    plain_table = (
        # pattern s    i,  j   expected, expected_i, expected_j
        ('a', 'baca',  0, -1, 'a', 1, 2),
        ('A', 'bAcde', 0, -1, 'A', 1, 2),
    )  # fmt: skip
    nocase_table = (
        # pattern s     i,  j   expected, expected_i, expected_j
        ('a', 'abaAca', 0, -1, 'a', 0, 1),
        ('A', 'abcdca', 0, -1, 'a', 0, 1),
    )  # fmt: skip
    word_table = (
        # pattern s      i,  j   expected, expected_i, expected_j
        ('a', 'abaAca',  0, -1,  '', -1, -1),
        ('A', 'AA A AAB', 0, -1, 'A', 3, 4),
        ('c.c', 'c = cc.c.c.chapterController', 0, -1, 'c.c', 7, 10),  # PR #5033.
    )  # fmt: skip
    test(plain_table, 'plain_table', nocase=False, word=False)
    test(nocase_table, 'nocase_table', nocase=True, word=False)
    test(word_table, 'word_table', nocase=False, word=True)

