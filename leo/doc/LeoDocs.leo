<t tx="ekr.20261116100828.1187">@cmd('backward-kill-paragraph')
def backwardKillParagraph(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Kill the previous paragraph."""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    with u.change_node(p, 'backward-kill-paragraph'):
        self.backwardParagraphHelper(None, extend=True)
        i, j = w.getSelectionRange()
        if i &gt; 0:
            i = min(i + 1, j)
        c.killBufferCommands.killParagraphHelper(i, j)
        p.v.b = w.getAllText()
        w.setSelectionRange(i, i, insert=i)
        c.k.resetLabel()

