for ext in extensions:
    new_files = glob.glob(
        f"{sub_directory}{os.sep}**{os.sep}*{ext}",
        recursive=True,
    )

    # _create_link_files converts these full paths to relative paths.
    files.extend([z for z in new_files if os.path.isfile(z) and z not in files])
