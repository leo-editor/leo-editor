<t tx="ekr.20261116100829.77">def new_run_test(
    self,
    s: str,
    expected_results: tuple,
    *,
    check: bool = True,
) -&gt; None:
    """
    Run a unit test of an import scanner,
    i.e., create a tree from string s at location p.
    """
    c = self.c
    ext = self.ext
    p = c.p
    self.assertTrue(ext)

    # Run the test.
    parent = p.insertAsLastChild()
    kind = self.compute_unit_test_kind(ext)

    # TestCase.id() has the form leo.unittests.core.file.class.test_name
    id_parts = self.id().split('.')
    self.short_id = f"{id_parts[-2]}.{id_parts[-1]}"
    parent.h = f"{kind} {self.short_id}"
    test_s = s

    # Leo 6.8.7:
    c.importCommands.createOutline(parent.copy(), ext, test_s, treeType='@clean')

    if check:
        # Dump the actual results on failure and raise AssertionError.
        self.check_outline(parent, expected_results)
    else:
        # Just dump the tree.
        self.dump_tree(p, tag='Actual results...')

</t>
<t tx="ekr.20261116100829.78">def run_test(self, s: str) -&gt; Position:
    """
    Run a unit test of an import scanner,
    i.e., create a tree from string s at location c.p.
    Return the created tree.
    """
    c = self.c
    ext = self.ext
    p = c.p
    self.assertTrue(ext)

    # Run the test.
    parent = p.insertAsLastChild()
    kind = self.compute_unit_test_kind(ext)

    # TestCase.id() has the form leo.unittests.core.file.class.test_name
    id_parts = self.id().split('.')
    self.short_id = f"{id_parts[-2]}.{id_parts[-1]}"
    parent.h = f"{kind} {self.short_id}"
    test_s = self.prep(s)
    c.importCommands.createOutline(parent.copy(), ext, test_s)
    return parent

