<t tx="ekr.20261116100828.906">def markAtFileNodesDirty(
    self,
    event: Any = None,  # not used.
) -&gt; None:
    """Mark all @file nodes in the selected tree as changed."""
    c = self
    p = c.p
    if not p:
        return
    c.endEditing()
    after = p.nodeAfterTree()
    while p and p != after:
        if p.isAtFileNode():
            p.setDirty()
            c.setChanged()
            p.moveToNodeAfterTree()
        else:
            p.moveToThreadNext()

