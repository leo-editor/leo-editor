<t tx="ekr.20261116100828.777">def all_positions(self, copy: bool = True) -&gt; PositionGenerator:
    """A generator return all positions of the outline, in outline order."""
    c = self
    p = c.rootPosition()
    while p:
        yield p.copy() if copy else p
        p.moveToThreadNext()

