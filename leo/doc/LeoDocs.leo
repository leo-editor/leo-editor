<t tx="ekr.20261116100828.507">class LoadManager:
    """A class to manage loading .leo files, including configuration files."""

    __slots__ = (
        'files',
        'globalBindingsDict',
        'globalSettingsDict',
        'leo_settings_c',
        'leo_settings_path',
        'more_cmdline_files',
        'my_settings_c',
        'my_settings_path',
        'old_argv',
        'options',
        'theme_c',
        'theme_path',
    )

    LM_NOTHEME_FLAG = 'lm_theme_use_none'

    @others


