<t tx="ekr.20261116100828.977">def canPasteOutline(self, s: str = '') -&gt; bool:
    # c = self
    if not s:
        s = g.app.gui.getTextFromClipboard()
    # check for JSON
    if s and s.lstrip().startswith("{"):
        try:
            d = json.loads(s)
            if not ('vnodes' in d and 'tnodes' in d):
                return False
        except Exception:
            return False
        return True
    if s and g.match(s, 0, g.app.prolog_prefix_string):
        return True
    return False

