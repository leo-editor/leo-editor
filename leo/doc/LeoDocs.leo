<t tx="ekr.20261116100828.970">def canExtract(self) -&gt; bool:
    return True  # #4015.

canExtractSectionNames = canExtract

def canExtractSection(self) -&gt; bool:
    c = self
    w = c.frame.body.wrapper
    if not w:
        return False
    s = w.getSelectedText()
    if not s:
        return False
    line = g.get_line(s, 0)
    i1 = line.find("&lt;&lt;")
    j1 = line.find("&gt;&gt;")
    i2 = line.find("@&lt;")
    j2 = line.find("@&gt;")
    return -1 &lt; i1 &lt; j1 or -1 &lt; i2 &lt; j2

</t>
<t tx="ekr.20261116100828.971">
def canFindMatchingBracket(self) -&gt; bool:
    c = self
    brackets = "()[]{}"
    w = c.frame.body.wrapper
    s = w.getAllText()
    ins = w.getInsertPoint()

    # fmt: off
    c1 = s[ins]   if 0 &lt;= ins   &lt; len(s) else ''
    c2 = s[ins-1] if 0 &lt;= ins-1 &lt; len(s) else ''
    # fmt: on

    val = (c1 and c1 in brackets) or (c2 and c2 in brackets)
    return bool(val)

