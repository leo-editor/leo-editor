<t tx="ekr.20261116100828.15">def legend(self) -&gt; str:
    """Compute legend for self.c"""
    c = self.c
    lm = g.app.loadManager
    legend = f'''\
        @language rest

        legend:

            leoSettings.leo
         @  @button, @command, @mode
        [D] default settings
        [F] local file: {c.shortFileName()}
        [M] myLeoSettings.leo
        '''
    if lm.theme_path:
        legend = legend + f"[T] theme file: {g.shortFileName(lm.theme_path)}\n"
    return textwrap.dedent(legend)

