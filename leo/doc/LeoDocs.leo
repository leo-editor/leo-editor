<t tx="ekr.20261116100828.468">def createFrame(
    self,
    parent: QWidget,
    name: str,
    hPolicy: Policy | None = None,
    vPolicy: Policy | None = None,
    lineWidth: int = 1,
    shadow: Shadow | None = None,
    shape: Shape | None = None,
) -&gt; QWidget:
    """Create a Qt Frame."""
    if shadow is None:
        shadow = Shadow.Plain
    if shape is None:
        shape = Shape.NoFrame

    w = QtWidgets.QFrame(parent)
    self.set_widget_size_policy(w, kind1=hPolicy, kind2=vPolicy)
    w.setFrameShape(shape)
    w.setFrameShadow(shadow)
    w.setLineWidth(lineWidth)
    self.setName(w, name)
    return w

