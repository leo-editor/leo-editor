<t tx="ekr.20261116100828.975">def canMoveOutlineRight(self) -&gt; bool:
    c = self
    p = c.p
    if c.hoistStack:
        bunch = c.hoistStack[-1]
        return bool(p and p.hasBack() and p != bunch.p)
