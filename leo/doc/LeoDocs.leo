<t tx="ekr.20261116100828.3651">def test_insert_newline_bug_2230(self):
    # Insert newline should insert a newline at the insertion point.
    before_b = self.prep(
        """
            @language python
            def spam():
                if 1:  # test
            # after line
        """)  # fmt: skip

    after_b = self.prep(
        """
            @language python
            def spam():
                if 1:  # test
            [8spaces]
            # after line
        """)  # fmt: skip

    self.run_test(
        before_b=before_b,
        after_b=after_b.replace('[8spaces]', ' ' * 8),
        before_sel=("3.17", "3.17"),  # Before the newline.
        after_sel=("4.8", "4.8"),
        command_name="insert-newline",
    )

