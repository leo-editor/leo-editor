<t tx="ekr.20261116100829.498">def test_multiple_moves(self):
    # Test a group of moves.
    c = self.c
    p = c.p
    u = c.undoer
    p1 = p.insertAfter()
    p1.h = 'p1'
    p2 = p1.insertAfter()
    p2.h = 'p2'
    p3 = p2.insertAfter()
    p3.h = 'p3'
    p4 = p3.insertAfter()
    p4.h = 'p4'
    u.clearUndoState()
    # Do moves that invalidate nodes.
    c.selectPosition(p2)
    c.moveOutlineRight()  # Invalidates p2, p3, p4
    # Re-establish p3 and p4.
    p3 = p1.next()
    assert p3.h == 'p3', p3.h
    p4 = p3.next()
    assert p4.h == 'p4', p4.h
    c.selectPosition(p3)
    c.moveOutlineDown()
    # Undo and redo thrice.
    for _i in range(3):
        u.undo()
        u.redo()

