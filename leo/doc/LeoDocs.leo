<t tx="ekr.20261116100828.167">def writeException(self, fileName: str, root: Position) -&gt; None:  # pragma: no cover
    at = self
    g.error("exception writing:", fileName)
    g.es_exception()
    if getattr(at, 'outputFile', None):
        assert at.outputFile
        at.outputFile.flush()
        at.outputFile.close()
        at.outputFile = None
    at.remove(fileName)
    at.addToOrphanList(root)

