<t tx="ekr.20261116100828.1225">@cmd('file-insert')
def insertFile(self, event: LeoKeyEvent | None = None) -&gt; None:
    """
    Prompt for the name of a file.
    Insert the file's contents in the body at the insertion point.
    """
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    fn = self.getReadableTextFile()
    if not fn:
        return
    s, e = g.readFileIntoString(fn)
    if s is not None:
        with u.change_node(p, 'insert-file'):
            i = w.getInsertPoint()
            w.insert(i, s)
            w.seeInsertPoint()
            p.v.b = w.getAllText()
            c.k.resetLabel()

