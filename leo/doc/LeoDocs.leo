<t tx="ekr.20261116100828.927">def dragAfter(self, p: Position, after: Position) -&gt; None:
    c = self
    p = c.p
    u = c.undoer
    if not c.checkDrag(p, after):
        return
    if not c.checkMoveWithParentWithWarning(p, after.parent(), True):
        return
    assert p.v
    c.endEditing()
    with u.move_node(p, 'Drag'):
        p.setDirty()
        p.moveAfter(after)
        p.setDirty()
        c.p = p

