<t tx="ekr.20261116100828.3561">def dump_bodies(self, c: Cmdr) -&gt; None:  # pragma: no cover
    """Dump all headlines."""
    print('')
    g.trace(c.fileName())
    print('')
    for p in c.all_positions():
        head_s = f"{' ' * p.level()} {p.h}"
        print(f"{p.gnx:&lt;28} {head_s:&lt;20} body: {p.b!r}")

