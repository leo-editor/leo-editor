<t tx="ekr.20261116100828.164">def tabNannyNode(self, p: Position, body: str) -&gt; None:
    try:
        readline = g.ReadLinesClass(body).next
        tabnanny.process_tokens(tokenize.generate_tokens(readline))
    except IndentationError:  # pragma: no cover
        if g.unitTesting:
            raise
        _, msg, _ = sys.exc_info()
        g.error("IndentationError in", p.h)
        g.es('', str(msg))
    except tokenize.TokenError:  # pragma: no cover
        if g.unitTesting:
            raise
        _, msg, _ = sys.exc_info()
        g.error("TokenError in", p.h)
        g.es('', str(msg))
    except tabnanny.NannyNag:
        if g.unitTesting:
            raise
        _, nag, _ = sys.exc_info()
        badline = nag.get_lineno()
        line = nag.get_line()
        message = nag.get_msg()
        g.error("indentation error in", p.h, "line", badline)
        g.es(message)
        line2 = repr(str(line))[1:-1]
        g.es("offending line:\n", line2)
    except Exception:
        g.trace("unexpected exception")
        g.es_exception()
        raise

