<t tx="ekr.20261116100828.479">def closeEvent(self, event: QEvent) -&gt; None:
    """Handle a close event in the Leo window."""
    c = self.leo_c
    if not c.exists:
        # Fixes double-prompt bug on Linux.
        event.accept()
        return
    if c.inCommand:
        c.requestCloseWindow = True
        return
    if g.app.closeLeoWindow(c.frame):
        event.accept()
    else:
        event.ignore()

