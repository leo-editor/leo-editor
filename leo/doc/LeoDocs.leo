<t tx="ekr.20261116100828.1172">@cmd('rectangle-string')
def stringRectangle(self, event: LeoKeyEvent | None = None) -&gt; None:
    """
    Prompt for a string, then replace the contents of a rectangle
    with a string on each line.
    """
    c = self.c
    k = c.k
    w = self.w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    if not w.hasSelection():
        return

    if g.unitTesting:
        k.arg = 's...s'  # This string is known to the unit test.
        self.stringRect = self.getRectanglePoints(self.w)
        self.stringRectangle1(event)
        return
    self.stringRect = self.getRectanglePoints(self.w)
    k.setLabelBlue('String rectangle: ')
    k.get1Arg(event, handler=self.stringRectangle1)

def stringRectangle1(self, event: LeoKeyEvent | None = None) -&gt; None:
    c = self.c
    k = c.k
    p = c.p
    u = c.undoer
    w = self.w
    k.clearState()
    k.resetLabel()
    c.bodyWantsFocus()
    r1, r2, r3, r4 = self.stringRect
    s = w.getAllText()
    for r in range(r1, r3 + 1):
        i = g.convertRowColToPythonIndex(s, r - 1, r2)
        j = g.convertRowColToPythonIndex(s, r - 1, r4)
        s = s[:i] + k.arg + s[j:]
    i = g.convertRowColToPythonIndex(s, r1 - 1, r2)
    j = g.convertRowColToPythonIndex(s, r3 - 1, r2 + len(k.arg))
    with u.change_node(p, 'string-rectangle'):
        w.setAllText(s)
        p.v.b = s
        w.setSelectionRange(i, j)

</t>
<t tx="ekr.20261116100828.1173">@cmd('backward-kill-sentence')
def backwardKillSentence(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Kill the previous sentence."""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    s = w.getAllText()
    ins = w.getInsertPoint()
    i = s.rfind('.', ins)
    if i == -1:
        return
    with u.change_node(p, 'backward-kill-sentence'):
        i2 = s.rfind('.', 0, i) + 1
        self.killHelper(event, i2, i + 1, w)
        w.setInsertPoint(i2)
        c.k.resetLabel()
        p.v.b = w.getAllText()

</t>
<t tx="ekr.20261116100828.1174">@cmd('backward-kill-word')
def backwardKillWord(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Kill the previous word."""
    c = self.c
    p = c.p
    u = c.undoer
    # Must be valid in headlines.
    w = event.w if event else c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    with u.change_node(p, 'backward-kill-word'):
        c.editCommands.backwardWord(event)
        c.editCommands.extendToWord(event)
        i, j = w.getSelectionRange()
        self.killHelper(event, i, j, w)
        if g.app.is_body_wrapper(w):
            p.v.b = w.getAllText()
        c.k.resetLabel()

@cmd('kill-word')
def killWord(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Kill the word containing the cursor."""
    c = self.c
    p = c.p
    u = c.undoer
    # Must be valid in headlines.
    w = event.w if event else c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    with u.change_node(p, 'kill-word'):
        c.editCommands.extendToWord(event)
        i, j = w.getSelectionRange()
        self.killHelper(event, i, j, w)
        if g.app.is_body_wrapper(w):
            p.v.b = w.getAllText()
        c.k.resetLabel()

