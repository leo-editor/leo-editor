<t tx="ekr.20261116100828.1394">def updateHead(self, event: LeoKeyEvent | None, w: QTextMixin) -&gt; None:
    """
    Update a headline from an event.

    The headline officially changes only when editing ends.
    """
    k = self.c.k
    ch = event.char if event else ''
    i, j = w.getSelectionRange()
    ins = w.getInsertPoint()
    if i != j:
        ins = i
    if ch in ('\b', 'BackSpace'):
        if i != j:
            w.delete(i, j)
            # Bug fix: 2018/04/19.
            w.setSelectionRange(i, i, insert=i)
        elif i &gt; 0:
            i -= 1
            w.delete(i)
            w.setSelectionRange(i, i, insert=i)
        else:
            w.setSelectionRange(0, 0, insert=0)
    elif ch and ch not in ('\n', '\r'):
        if i != j:
            w.delete(i, j)
        elif k.unboundKeyAction == 'overwrite':
            w.delete(i, i + 1)
        w.insert(ins, ch)
        w.setSelectionRange(ins + 1, ins + 1, insert=ins + 1)
    s = w.getAllText()
    if s.endswith('\n'):
        s = s[:-1]
    # 2011/11/14: Not used at present.
    # w.setWidth(self.headWidth(s=s))
    if ch in ('\n', '\r'):
        self.endEditLabel()

