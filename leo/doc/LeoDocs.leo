<t tx="ekr.20261116100828.1198">@cmd('delete-spaces')
def deleteSpaces(self, event: LeoKeyEvent | None = None, insertspace: bool = False) -&gt; None:
    """Delete all whitespace surrounding the cursor."""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    s = w.getAllText()
    ins = w.getInsertPoint()
    i, j = g.getLine(s, ins)
    w1 = ins - 1
    while w1 &gt;= i and s[w1].isspace():
        w1 -= 1
    w1 += 1
    w2 = ins
    while w2 &lt;= j and s[w2].isspace():
        w2 += 1
    if s[w1:w2]:  # spaces.
        with u.change_node(p, 'insert-space'):
            if insertspace:
                s = s[:w1] + ' ' + s[w2:]
            else:
                s = s[:w1] + s[w2:]
            p.v.b = s
            w.setAllText(s)
            w.setInsertPoint(w1)

