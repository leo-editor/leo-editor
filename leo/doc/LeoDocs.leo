<t tx="ekr.20261116100828.324">def get_jupyter_source(self, c: Cmdr) -&gt; str:
    """Return the html for the @jupyter node."""
    # # nbformat (@jupyter) support.
    try:
        import nbformat
        from nbconvert import HTMLExporter
    except ImportError:
        nbformat = None

    body = c.p.b.lstrip()
    if body.startswith('&lt;'):
        # Assume the body is html.
        return body
    if body.startswith('{'):
        # Leo 5.7.1: Allow raw JSON.
        s = body
    else:
        url = c.p.h.split()[1]
        if not url:
            return ''
        if not nbformat:
            return 'can not import nbformat to render url: %r' % url
        try:
            s = urlopen(url).read().decode()
        except Exception:
            return 'url not found: %s' % url

    try:
        nb = nbformat.reads(s, as_version=4)
        e = HTMLExporter()
        (s, junk_resources) = e.from_notebook_node(nb)
    except nbformat.reader.NotJSONError:
        pass  # Assume the result is html.
    return s

</t>
<t tx="ekr.20261116100828.325">def update_katex(self, s: str, keywords: Any) -&gt; None:
