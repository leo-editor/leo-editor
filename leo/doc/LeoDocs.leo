<t tx="ekr.20261116100829.503">def test_u_clone_node(self):
    c = self.c
    p = c.p
    u = c.undoer
    p.b = 'before'
    v = p.v

    def test() -&gt; None:
        with u.change_node(p, 'my-command'):
            p.b = 'after'
            clone = u.clone_node(p)
            assert clone.v == v
            clone.setMarked()  # For coverage testing.

    for _i in range(3):
        test()
        assert len(u.beads) == 1
        assert p.b == 'after'
        assert c.p.isCloned()
        u.undo()
        assert len(u.beads) == 1
        assert p.b == 'before'
        assert not c.p.isCloned()
        u.redo()
        assert len(u.beads) == 1
        assert p.b == 'after'
        assert c.p.isCloned()
        u.undo()
        assert len(u.beads) == 1
        assert p.b == 'before'
        assert not c.p.isCloned()

