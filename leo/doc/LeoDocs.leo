<t tx="ekr.20261116100828.1104">@g.commander_command('paste-node')
def pasteOutline(
    self: Cmdr, event: LeoKeyEvent | None = None, s: str | None = None
) -&gt; Position | None:
    """
    Paste an outline into the present outline from the clipboard.
    Nodes do *not* retain their original identify.
    """
    c = self
    u = c.undoer
    if s is None:
        s = g.app.gui.getTextFromClipboard()
    c.endEditing()
    if not s or not c.canPasteOutline(s):
        return None
    if not (s.lstrip().startswith("{") or g.match(s, 0, g.app.prolog_prefix_string)):
        return None
    with u.change_outline('paste-node'):
        pasted = c.fileCommands.getLeoOutlineFromClipboard(s)
        if not pasted:
            return None
        if c.checkOutline():  # Error.
            pasted.doDelete()
            c.p = c.rootPosition()
            return None
        pasted.setDirty()
        back = pasted.back()
        if back and back.hasChildren() and back.isExpanded():
            pasted.moveToNthChildOf(back, 0)
            pasted.setDirty()
        c.p = pasted
        return pasted


