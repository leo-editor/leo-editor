<t tx="ekr.20261116100829.480">def _require_bead(self) -&gt; UndoBead:
    """Reject helper calls outside a context before any mutation occurs."""
    assert isinstance(self.undoBead, UndoBead), "Undo helper requires 'with c.undoer'"
    return self.undoBead

</t>
<t tx="ekr.20261116100829.481">def cutStack(self) -&gt; None:
    """Cut the stack back to u.max_undo_stack_size entries."""
    u = self
    n = u.max_undo_stack_size
    if u.bead &gt;= n &gt; 0:
        # This work regardless of how many items appear after bead n.
        u.beads = u.beads[-n:]
        u.bead = n - 1

</t>
<t tx="ekr.20261116100829.482">def getBead(self, n: int) -&gt; UndoBead | None:
    """Set Undoer ivars from the bead at the top of the undo stack."""
    u = self
    return u.beads[n] if 0 &lt;= n &lt; len(u.beads) else None

peekBead = getBead  # Compatibility

</t>
<t tx="ekr.20261116100829.483">def pushBead(self, bead: UndoBead) -&gt; None:
    u = self
    u.bead += 1
    u.beads[u.bead :] = [bead]
    u.setUndoTypes()

