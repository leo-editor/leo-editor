<t tx="ekr.20261116100829.490">def do_import(self) -&gt; Position | None:
    """
    Base_Indented_Importer.do_import: Create a top-level node containing study outlines for all files in
    c.p and its descendants.

    Return the top-level node for unit tests.
    """
    c, p, u = self.c, self.c.p, self.c.undoer

    assert self.extensions

    def predicate(p: Position) -&gt; bool:
        return self.isAtFileNode(p) and p.h.strip().endswith(tuple(self.extensions))

    roots: list[Position] = g.findRootsWithPredicate(c, p, predicate)  # Removes duplicates
    if not roots:
        return None

    # Undoably create top-level organizer node and import all files.
    try:
        last = c.lastTopLevel()
        c.selectPosition(last)
        with u.change_outline('Import Indented Language'):
            # Always create a new last top-level node.
            parent = last.insertAfter()
            parent.v.h = 'indented files'
            for root in roots:
                self.import_one_file(root, parent)
    except Exception:
        g.es_print(f"Exception in {self.__class__.__name__}")
        g.es_exception()
    finally:
        for p2 in parent.self_and_subtree(copy=False):
            p2.contract()
        c.redraw(parent)
    return parent

</t>
<t tx="ekr.20261116100829.491">def redo(self) -&gt; None:
    c = self.c
    p = self.p
    w = self.w

    # Update p's data.
    p.v.b = self.new_lines
    p.setDirty()
    if self.marked:
        c.setMarked(p)
    else:
        c.clearMarked(p)

    # Update global data.
    c.redraw(p)
    c.frame.scanForTabWidth(p)  # Calls frame.setTabWidth()
    c.recolor(p)  # Trigger pygments colorizing.

    # Update w *last*.
    w.setAllText(p.b)  # Trigger jEdit colorizing.
    w.setSelectionRange(*self.new_sel, insert=self.new_ins)
    if self.scroll is not None:
        w.setYScrollPosition(self.scroll)
    w.setFocus()

</t>
<t tx="ekr.20261116100829.492">def undo(self) -&gt; None:
    c = self.c
    p = self.p
    w = self.w

    # Update p's data.
    p.v.b = self.old_lines
    p.setDirty()
    if self.marked:
        c.setMarked(p)
    else:
        c.clearMarked(p)

    # Update global data.
    c.redraw(p)
    c.frame.scanForTabWidth(p)  # Calls frame.setTabWidth()
    c.recolor(p)  # Trigger pygments colorizing.

    # Update w *last*.
    w.setAllText(p.b)  # Trigger jEdit colorizing.
    w.setSelectionRange(*self.old_sel, insert=self.old_ins)
    if self.scroll is not None:
        w.setYScrollPosition(self.scroll)
    w.setFocus()

