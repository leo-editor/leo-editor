<t tx="ekr.20261116100828.96">def writer_for_ext(self, ext: str) -&gt; Callable | None:  # pragma: no cover
    """A factory returning a writer function for the given file extension."""
    at = self
    d = g.app.writersDispatchDict
    if aClass := d.get(ext):

        def writer_for_ext_cb(root: Position) -&gt; str | None:
            try:
                return aClass(at.c).write(root)
            except Exception:
                g.es_exception()
                return None

        return writer_for_ext_cb

    return None

