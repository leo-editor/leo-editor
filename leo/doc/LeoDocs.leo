<t tx="ekr.20261116100828.158">def putIndent(self, n: int, s: str = '') -&gt; None:  # pragma: no cover
    """Put tabs and spaces corresponding to n spaces,
    assuming that we are at the start of a line.
    """
    if n &gt; 0:
        w = self.tab_width
        if w &gt; 1:
            q, r = divmod(n, w)
            self.otabs(q)
            self.oblanks(r)
        else:
            self.oblanks(n)

