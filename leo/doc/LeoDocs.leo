<t tx="ekr.20261116100828.1082">_currentCount = 0

def setCurrentPosition(self, p: Position) -&gt; None:
    """
    Set the presently selected position. For internal use only.
    Client code should use c.selectPosition instead.
    """
    c = self
    if not p:
        g.trace('===== no p', g.callers())
        return
    if c.positionExists(p):
        if c._currentPosition and p == c._currentPosition:
            pass  # We have already made a copy.
        else:  # Make a copy _now_
            c._currentPosition = p.copy()
    else:
        message = f"Invalid position in {c.shortFileName()}\n{p!r}\n{g.callers(10)=}"
        if g.unitTesting:
            raise AssertionError(message)
        print()
        g.trace(message)
        print()
        c._currentPosition = c.rootPosition()

# For compatibility with old scripts.

setCurrentVnode = setCurrentPosition

