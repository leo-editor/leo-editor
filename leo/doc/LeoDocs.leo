<t tx="ekr.20261116100828.109">def atFileToString(self, root: Position, sentinels: bool = True) -&gt; str:  # pragma: no cover
    """Write an external file to a string, and return its contents."""
    at, c = self, self.c
    try:
        c.endEditing()
        at.initWriteIvars(root)
        at.sentinels = sentinels
        at.outputList = []
        at.putFile(root, sentinels=sentinels)
        assert root == at.root, 'write'
        contents = '' if at.errors else ''.join(at.outputList)
        return contents
    except Exception:
        at.exception("exception preprocessing script")
        assert root.v
        root.v._p_changed = True
        return ''

