<t tx="ekr.20261116100828.1203">@cmd('insert-newline')
def insertNewLine(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Insert a newline at the cursor."""
    self.insertNewlineBase(event)

insertNewline = insertNewLine

def insertNewlineBase(self, event: LeoKeyEvent | None = None) -&gt; None:
    """A helper that can be monkey-patched by tables.py plugin."""
    # Note: insertNewlineHelper already exists.
    c = self.c
    k = c.k
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    oldSel = w.getSelectionRange()
    with u.change_node(p, 'insert-newline'):
        self.insertNewlineHelper(w=w, oldSel=oldSel, undoType='')
        p.v.b = w.getAllText()
        k.setInputState('insert')
        k.showStateAndMode()

