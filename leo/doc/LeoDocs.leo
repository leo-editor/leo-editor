    s = re.sub(r'\s*\n\s*', ' ', s).replace('  ', ' ').rstrip()
limit = 1000
if len(s) &gt; limit:
    g.warning("truncating headline to", limit, "characters")
    s = s[:limit]
s = g.checkUnicode(s or '')
