<t tx="ekr.20261116100828.114"></t>
<t tx="ekr.20261116100828.1141">@nosearch</t>
<t tx="ekr.20261116100828.1142">def update_status(self, *, redraw: bool = True) -&gt; None:
    """
    Update status after either an undo or redo:
    """
    return  ###
    u = self
    c = u.c
    w = c.frame.body.wrapper

    g.trace(f"{redraw=}", g.callers())  ###

    # PR #4809. c.p has already been set.

    # # 1451. *Always* set the changed bit.
    # Redrawing *must* be done here before setting u.undoing to False.
    i, j = w.getSelectionRange()
    ins = w.getInsertPoint()
    if redraw:
        c.redraw()
    c.recolor()
    if u.inHead:
        c.editHeadline()
        u.inHead = False
    else:
        c.bodyWantsFocus()
        w.setSelectionRange(i, j, insert=ins)
        w.seeInsertPoint()

