</t>
<t tx="ekr.20261116100829.452">@cmd('redo')
def redo(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Redo the operation undone by the last undo."""
    u = self
    c = u.c
    if not c.p:  # pragma: no cover
        return
    # End editing *before* getting state.
    c.endEditing()
    if not u.canRedo():
        return
    obj = u.getBead(u.bead + 1)
    if not obj:  # pragma: no cover
        return

    # Init status.
    u.redoing = True
    u.groupCount = 0

    # Dispatch.
    try:
        if isinstance(obj, UndoBead):
            obj.redo()
        else:  # pragma: no cover
            g.es_print_unique_message(f"no redo helper for {u.undoType}")
        c.checkOutline()
    finally:
        u.redoing = False
    u.bead += 1
    u.setUndoTypes()

</t>
<t tx="ekr.20261116100829.453">def type_text(
    self,
    p: Position,
    oldText: str,
    *,
    oldIns: int,
    oldSel: tuple[int, int],
    oldYview: int | None = None,
    w: QTextMixin,
) -&gt; None:
    """
    Push a new UndoTyping bead or merge the incoming changes to the top UndoTyping bead.

    Handle all undo tasks related to typing in the body pane. Called by:
    - ec.selfInsertCommand.
    - LeoQListWidget.select_callback.
    - QTextMixin.onTextChanged.
    """
    # Let block.
    w_ins = w.getInsertPoint()
    w_sel = w.getSelectionRange()
    w_text = w.getAllText()
    if self.undoing or self.redoing or oldText == w_text:  # pragma: no cover
        return
    u = self
    c = u.c
    w = c.frame.body.wrapper
    b = u.getBead(u.bead)
    if (
        not isinstance(b, TypingBead)
        or not u.beads
        or u.bead != len(u.beads) - 1
        or b.p.v != p.v
        or b.line_number != b.compute_line_number(w_ins, w_text)
        or c.redraw_count != b.redraw_count
        or abs(w_ins - oldIns) &gt; 1
    ):
        # Can't merge: create a new TypingBead.

        # This is the only instantiation of TypingBead in Leo.
        b = TypingBead(u, p, old_ins=oldIns, old_sel=oldSel, old_text=oldText, w=w)
        u.pushBead(b)
    else:
        # Can merge: use the existing TypingBead.
        b.new_lines = w_text
        b.new_sel = w_sel
        b.new_ins = w_ins
    p.v.b = w_text  # Do **not** use p.b = w_text!!!
    u._update_after_typing(p, w)

</t>
<t tx="ekr.20261116100829.454">def _update_after_typing(self, p: Position, w: QTextMixin) -&gt; None:
    """Update everything after changing body text."""
    c = self.c

    # An ever-present unit test.
    assert g.isTextWrapper(w), g.callers()

    # Let block.
    w_text = w.getAllText()
    w_ins = w.getInsertPoint()
    w_sel = w.getSelectionRange()

    # Update p's data.
    if p == c.p:
        assert p.b == w_text, (w, g.callers())
    p.v.insertSpot = w_ins
    i, j = w_sel
    p.v.selectionStart, p.v.selectionLength = (i, j - i)
    if not p.isDirty():
        p.setDirty()

    # Update icons.
    val = p.computeIcon()
    if not hasattr(p.v, "iconVal") or val != p.v.iconVal:
        p.v.iconVal = val

    # Update global data.
    if not c.isChanged():
        c.setChanged()
    if p == c.p:
        c.frame.scanForTabWidth(p)  # Calls frame.setTabWidth()
        c.recolor()

    # Ensure focus.
    w.setFocus()

</t>
<t tx="ekr.20261116100829.455">@cmd('undo')
def undo(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Undo the operation described by the undo parameters."""
    u = self
    c = u.c
    if not c.p:  # pragma: no cover
        g.trace('no current position')
        return
    # End editing *before* getting state.
    c.endEditing()
    if not u.canUndo():
        return
    obj = u.getBead(u.bead)
    if not obj:  # pragma: no cover
        return

    # Init status.
    u.undoing = True
    u.groupCount = 0

    # Dispatch.
    try:
        if isinstance(obj, UndoBead):
            obj.undo()
        else:  # pragma: no cover
            g.es_print_unique_message(f"no undo helper for {u.undoType}")
        c.checkOutline()
    finally:
        u.undoing = False
    u.bead -= 1
    u.setUndoTypes()

</t>
<t tx="ekr.20261116100829.456"></t>
<t tx="ekr.20261116100829.457">def change_headline(self, p: Position, new_h: str, *, ch: str = '') -&gt; None:
    """
    Change a headline and preserve directives, dirty bits and editor state.

    Called *only* from LeoTree.onHeadChanged

    This method should *not* have an @contextmanager decorator:
    it is never called from within other @contextmanager methods.
    """
    u = self
    b = u._require_bead()
    c = u.c
    old_h = p.h
    if old_h == new_h:  # pragma: no cover
        return

    p = p.copy()

    def update(head: str) -&gt; None:
        c.p = p
        p.initHeadString(head)
        p.setDirty()  # Call p.v.setAllAncestorAtFileNodesDirty()
        c.frame.tree.setHeadline(p, head)

    # Do the action.
    # Leave the live editor alone: it may contain multiline abbreviation text.
    p.initHeadString(new_h)
    p.setDirty()  # Call p.v.setAllAncestorAtFileNodesDirty()
    c.frame.scanForTabWidth(p)
    c.recolor(p)
    g.doHook('headkey2', c=c, p=p, ch=ch, changed=True)

    # Add helpers

    def change_headline_redoer() -&gt; None:
        update(new_h)

    def change_headline_undoer() -&gt; None:
        update(old_h)

    b.add_helpers(change_headline_redoer, change_headline_undoer)
    b.add_recolor(p, p)

</t>
