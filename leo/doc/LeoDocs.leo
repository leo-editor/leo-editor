<t tx="ekr.20261116100828.120">def putAtOthersLine(self, s: str, i: int, p: Position) -&gt; None:
    """Put the expansion of @others."""
    at = self
    j, delta = g.skip_leading_ws_with_indent(s, i, at.tab_width)
    k = g.skip_to_end_of_line(s, i)
    at.putLeadInSentinel(s, i, j)
    at.indent += delta
    # s[j:k] starts with '@others'
    # Never write lws in new sentinels.
    at.putSentinel("@+" + s[j + 1 : k].strip())
    for child in p.children():
        p = child.copy()
        after = p.nodeAfterTree()
        while p and p != after:
            if at.validInAtOthers(p):
                at.putOpenNodeSentinel(p)
                if at.putBody(p):
                    p.moveToNodeAfterTree()
                else:
                    p.moveToThreadNext()
            else:
                p.moveToNodeAfterTree()
    # This is the same in both old and new sentinels.
    at.putSentinel("@-others")
    at.indent -= delta

