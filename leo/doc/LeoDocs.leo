<t tx="ekr.20261116100828.91">def writeMissing(self, p: Position) -&gt; None:  # pragma: no cover
    at, c = self, self.c
    writtenFiles = False
    c.init_error_dialogs()
    # #1450.
    at.initWriteIvars(root=p.copy())
    p = p.copy()
    after = p.nodeAfterTree()
    while p and p != after:  # Don't use iterator.
        if p.isAtAsisFileNode() or (p.isAnyAtFileNode() and not p.isAtIgnoreNode()):
            if fileName := p.anyAtFileNodeName():
                fileName = c.fullPath(p)  # #1914.
                if at.precheck(fileName, p):
                    at.writeMissingNode(p)
                    writtenFiles = True
                else:
                    at.addToOrphanList(p)
            p.moveToNodeAfterTree()
        elif p.isAtIgnoreNode():
            p.moveToNodeAfterTree()
        else:
            p.moveToThreadNext()
    if not g.unitTesting:
        if writtenFiles:
            g.es("finished")
        else:
            g.es("no @file node in the selected tree")
    c.raise_error_dialogs(kind='write')

