<t tx="ekr.20261116100828.1201">@cmd('indent-to-comment-column')
def indentToCommentColumn(self, event: LeoKeyEvent | None = None) -&gt; None:
    """
    Insert whitespace to indent the line containing the insert point to the
    comment column.
    """
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    with u.change_node(p, 'indent-to-comment-column'):
        s = w.getAllText()
        ins = w.getInsertPoint()
        i, j = g.getLine(s, ins)
        line = s[i:j]
        c1 = self.ccolumn
        line2 = ' ' * c1 + line.lstrip()
        if line2 != line:
            w.delete(i, j)
            w.insert(i, line2)
        w.setInsertPoint(i + c1)
        p.v.b = w.getAllText()
        c.k.resetLabel()

