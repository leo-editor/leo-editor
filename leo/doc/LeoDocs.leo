<t tx="ekr.20261116100828.700">def doWindowSpotOption() -&gt; tuple[int, int] | None:
    """Handle --window-spot"""
    m = utils.find_complex_option(r'--window-spot=(\d+)x(\d+)')
    if not m:
        return None
    try:
        top, left = int(m.group(1)), int(m.group(2))
    except ValueError:
        arg = m.group(0)
        utils.option_error(arg, 'Invalid value: expected int x int')
    return top, left

