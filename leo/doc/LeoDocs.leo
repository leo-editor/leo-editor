<t tx="ekr.20261116100828.300">def getVr(event: LeoKeyEvent | None) -&gt; ViewRenderedController | None:
    """
    Return the singleton instance for this commander.
    """
    # First, get c.
    if not event:
        return None
    c = event.get('c')
    if not c:
        return None
    vr = getattr(c, 'vr', None)
    if not vr:
        g.es_print_unique_message(f"{c.shortFileName()}: viewrendered commands disabled")
    return vr


