<t tx="ekr.20261116100829.305">def getSelectionRange(self, sort: bool = True) -&gt; tuple[int, int]:
    """QTextEditWrapper."""
    w = self.widget
    tc = w.textCursor()
    i, j = tc.selectionStart(), tc.selectionEnd()
    s = self.getAllText()
    i, j = qtIndexToPython(s, i), qtIndexToPython(s, j)
    if sort and i &gt; j:
        i, j = j, i
    return i, j

