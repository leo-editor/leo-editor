<t tx="ekr.20261116100828.976">def canMoveOutlineUp(self) -&gt; bool:
    c = self
    current = c.p
    visBack = current and current.visBack(c)
    if not visBack:
        return False
    if visBack.visBack(c):
        return True
    if c.hoistStack:
        limit, limitIsVisible = c.visLimit()
        if limitIsVisible:  # A hoist
            assert limit
            return current != limit
        # A chapter.
        return current != limit.firstChild()
    return current != c.rootPosition()

