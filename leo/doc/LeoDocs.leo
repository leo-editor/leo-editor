<t tx="ekr.20261116100828.905">def markAllAtFileNodesDirty(
    self,
    event: Any = None,  # not used.
) -&gt; None:
    """Mark all @file nodes as changed."""
    c = self
    c.endEditing()
    p = c.rootPosition()
    while p:
        if p.isAtFileNode():
            p.setDirty()
            c.setChanged()
            p.moveToNodeAfterTree()
        else:
            p.moveToThreadNext()

