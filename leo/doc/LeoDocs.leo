<t tx="ekr.20261116100828.3289">assert not in_doc, repr(line)

if m := self.doc_pat.match(line):
    # @+at or @+doc?
    doc = '@doc' if m.group(1) == 'doc' else '@'
    if doc2 := m.group(2) or '':  # Trailing text.
        body.append(f"{doc}{doc2}\n")
    else:
        body.append(doc + '\n')
    # Enter @doc mode.
    in_doc = True
    continue
