<t tx="ekr.20261116100828.1426">def insert(self, i: int, s: str) -&gt; int:
    """StringTextWrapper."""
    self.s = self.s[:i] + s + self.s[i:]
    i += len(s)
    self.ins = i
    self.sel = i, i
    return i  # PR #4812

