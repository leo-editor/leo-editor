        w = qt_text.LeoQTextBrowser(parent, c)
        w.setFrameShape(shape)
        w.setFrameShadow(shadow)
        w.setLineWidth(lineWidth)
        self.setName(w, name)
    if not hasattr(w, 'leo_wrapper'):
        cast(Any, w).leo_wrapper = QTextEditWrapper(widget=w, name=name, c=c)
