<t tx="ekr.20261116100828.1105">@g.commander_command('promote')
def promote(self: Cmdr, event: LeoKeyEvent | None = None) -&gt; None:
    """Make all children of the selected nodes siblings of the selected node."""
    c = self
    p = c.p
    u = c.undoer
    if not p or not p.hasChildren():
        c.treeFocusHelper()
        return
    c.endEditing()
    with u.change_outline('promote'):
        p.promote()
        p.setDirty()
        c.p = p


