<t tx="ekr.20261116100828.112">def putBody(self, p: Position, fromString: str = '') -&gt; bool:
    """
    Generate the body enclosed in sentinel lines.
    Return True if the body contains an @others line.
    """
    at = self
    s = fromString if fromString else p.b

    # Make sure v is never expanded again.
    # Suppress orphans check.
    p.v.setVisited()

    # #1048 &amp; #1037: regularize most trailing whitespace.
    if s and (at.sentinels or at.force_newlines_in_at_nosent_bodies):
        if not s.endswith('\n'):
            s = s + '\n'

    i = 0
    status = LeoIOStatus()
    # #4864: doc_indent lets a doc part nested in a leaf node's own block
    # (not via @others) match the surrounding code's indentation. It's
    # reset per node and saved/restored here so a child's trailing code
    # indentation can't leak into the parent or a sibling.
    old_doc_indent = at.doc_indent
    at.doc_indent = 0
    try:
        while i &lt; len(s):
            next_i = g.skip_line(s, i)
            assert next_i &gt; i, 'putBody'
            kind = at.directiveKind4(s, i)
            at.putLine(i, kind, p, s, status)
            i = next_i
        if not status.in_code:
            at.putEndDocLine()
            # An unclosed doc part (no @c/@code) still has its at.indent
            # bump in effect; undo it or it leaks into whatever's next.
            at.indent -= at.doc_indent
    finally:
        at.doc_indent = old_doc_indent
    return status.has_at_others

</t>
<t tx="ekr.20261116100828.1120">def connectEditorWidget(self, w: QLineEdit, item: QTreeWidgetItem) -&gt; QHeadlineWrapper | None:
    """
    Connect QLineEdit w to QTreeItem item.

    Also callback for when the editor ends.

    New in Leo 6.4: The callback handles all updates w/o calling onHeadChanged.
    """
    c = self.c
    p = c.p
    u = c.undoer

    @others  # define the callback.
    if w:
        # Hook up the widget.
        wrapper = self.getWrapper(w, item)
        w.editingFinished.connect(editingFinished_callback)
        return wrapper  # 2011/02/12
    return None

</t>
<t tx="ekr.20261116100828.1122">def redraw_after_head_changed(self) -&gt; None:
    """Redraw all Qt outline items cloned to c.p."""
    if self.busy:
        return
    c = self.c
    p = c.p
    if p:
        h = p.h  # 2010/02/09: Fix bug 518823.
        for item in self.vnode2items(p.v):
            if self.isValidItem(item):
                self.setItemText(item, h)
                if self.use_declutter:  # #2844.
                    icon = self.declutter_node(c, p.v, item)
                    item.setIcon(0, icon)  # 0 is the column number.

