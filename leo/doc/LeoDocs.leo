<t tx="ekr.20261116100828.141">def syntaxError(self, p: Position, body: str) -&gt; None:  # pragma: no cover
    """Report a syntax error."""
    g.error(f"Syntax error in: {p.h}")
    typ, val, tb = sys.exc_info()
    if message := hasattr(val, 'message') and val.message:
        g.es_print(message)
    if val is None:
        return
    lines = g.splitLines(body)
    n = val.lineno
    offset = val.offset or 0
    if n is None:
        return
    i = val.lineno - 1
    for j in range(max(0, i - 2), min(i + 2, len(lines) - 1)):
        line = lines[j].rstrip()
        if j == i:
            unl = p.get_UNL()
            g.es_print(f"{j + 1:5}:* {line}", nodeLink=f"{unl}::-{j + 1}")  # Global line.
            g.es_print(' ' * (7 + offset) + '^')
        else:
            g.es_print(f"{j + 1:5}: {line}")

</t>
<t tx="ekr.20261116100828.1410">def setHeadline(self, p: Position, s: str) -&gt; None:
    """Set the actual text of the headline widget.

    This is called from the undo/redo logic to change the text before redrawing."""
    w = self.headline_wrapper(p)
    if w:
        w.delete(0, w.getLastIndex())
        if s.endswith(('\n', '\r')):
            s = s[:-1]
        w.insert(0, s)
    else:
        g.trace('-' * 20, 'oops')  # pragma: no cover

