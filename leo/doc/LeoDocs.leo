<t tx="ekr.20261116100828.3567">def clean_tree(self) -&gt; None:
    """Clear everything but the root node."""
    p = self.root_p
    assert p.h == 'root'
    p.deleteAllChildren()
    while p.hasNext():
        p.next().doDelete()

