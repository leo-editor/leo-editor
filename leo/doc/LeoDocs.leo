<t tx="ekr.20261116100828.926">def dragToNthChildOf(self, p: Position, parent: Position, n: int) -&gt; None:
    c = self
    p = c.p
    u = c.undoer
    if not c.checkDrag(p, parent):
        return
    if not c.checkMoveWithParentWithWarning(p, parent, True):
        return
    c.endEditing()
    with u.move_node(p, 'Drag'):
        p.setDirty()
        p.moveToNthChildOf(parent, n)
        p.setDirty()
        c.p = p

