<t tx="ekr.20261116100829.73">def test_typing_in_non_empty_body_text_does_not_redraw_the_screen(self):
    c = self.c
    w = c.frame.body.wrapper
    h = 'Test headline abc'
    p = c.rootPosition().insertAfter()
    p.h = h
    c.setBodyString(p, 'a')
    p.v.iconVal = p.computeIcon()  # To suppress redraw!
    c.redraw(p)  # To make node visible
    c.bodyWantsFocus()
    n = c.frame.tree.redrawCount
    g.app.gui.event_generate(c, 'a', 'a', w)
    n2 = c.frame.tree.redrawCount
    self.assertEqual(n2, n)

