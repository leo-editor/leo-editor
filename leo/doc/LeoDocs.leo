<t tx="ekr.20261116100828.316">def update_asciidoc(self, s: str, keywords: Any) -&gt; None:
    """Update asciidoc in the VR pane."""
    # global asciidoctor_exec, asciidoc3_exec

    # Do this regardless of whether we show the widget or not.
    w = self.get_base_text_widget()
    assert self.w
    if s:
        self.show()
    if asciidoctor_exec or asciidoc3_exec:
        try:
            s2 = self.convert_to_asciidoctor(s)
            self.set_html(s2, w)
            return
        except Exception:
            g.es_exception()
    self.update_rst(s, keywords)

