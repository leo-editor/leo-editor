<t tx="ekr.20261116100828.1150">@g.commander_command('insert-node')
def insertHeadline(
    self: Cmdr, event: LeoKeyEvent | None = None, op_name: str = "Insert Node"
) -&gt; Position | None:
    """
    If c.p is expanded, insert a new node as the first or last child of c.p,
    depending on @bool insert-new-nodes-at-end.

    If c.p is not expanded, insert a new node after c.p.
    """
    c = self
    if not c.p:
        return None
    c.endEditing()
    with c.undoer as u:
        u.set_command_name(op_name)
        new_p = u.insert_node(c.p)
        u.redraw_and_edit(new_p)
        return new_p


</t>
<t tx="ekr.20261116100828.1151">@g.commander_command('insert-node-before')
def insertHeadlineBefore(self: Cmdr, event: LeoKeyEvent | None = None) -&gt; Position | None:
    """Insert a node before the presently selected node."""
    c = self
    if not c.p:
        return None
    if c.hoistStack and c.p == c.hoistStack[-1].p:
        g.warning('can not insert a node before the base of a hoist')
        return None
    c.endEditing()
    with c.undoer as u:
        u.set_command_name('insert-node-before')
        new_p = u.insert_node(c.p, before=True)
        u.redraw_and_edit(new_p)
        return new_p


</t>
<t tx="ekr.20261116100828.1154"></t>
<t tx="ekr.20261116100828.1155">@g.commander_command('clone-node')
def clone(self: Cmdr, event: LeoKeyEvent | None = None) -&gt; Position | None:
    """Create a clone of the selected outline."""
    c = self
    u = c.undoer
    if not c.p:
        return None
    c.endEditing()
    with u.change_outline('clone-node'):
        clone = u.clone_node(c.p)  # Cloning a node is *always* valid.
        c.p = clone
        c.treeWantsFocus()
        return clone


</t>
<t tx="ekr.20261116100828.116">def putAtAllLine(self, s: str, i: int, p: Position) -&gt; None:
    """Put the expansion of @all."""
    at = self
    j, delta = g.skip_leading_ws_with_indent(s, i, at.tab_width)
    k = g.skip_to_end_of_line(s, i)
    at.putLeadInSentinel(s, i, j)
    at.indent += delta
    # s[j:k] starts with '@all'
    at.putSentinel("@+" + s[j + 1 : k].strip())
    for child in p.children():
        at.putAtAllChild(child)
    at.putSentinel("@-all")
    at.indent -= delta

</t>
