<t tx="ekr.20261116100828.939">def redraw_later(self) -&gt; None:
    """
    Ensure that c.redraw() will be called eventually.

    c.outerUpdate will call c.redraw() only if no other code calls c.redraw().
    """
    c = self
    if not c.requestLaterRedraw and 'drawing' in g.app.debug:
        g.trace(f"set c.requestLaterRedraw: {c.shortFileName():&gt;20} {g.callers(1)}")
    c.requestLaterRedraw = True

