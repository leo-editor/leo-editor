<t tx="ekr.20261116100829.245">def computeIcon(self) -&gt; int:  # pragma: no cover
    v = self
    val = 0
    if v.hasBody():
        val += 1
    if v.isMarked():
        val += 2
    if v.isCloned():
        val += 4
    if v.isDirty():
        val += 8
    return val

def setIcon(self) -&gt; None:  # pragma: no cover
    pass  # Compatibility routine for old scripts

