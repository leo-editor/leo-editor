<t tx="ekr.20261116100828.3607">def test_clean_lines(self):
    before_b = self.prep(
        """
            # Should remove all trailing whitespace.

            a = 2

                b = 3
                c  = 4
            d = 5
            e = 6
            x
        """)  # fmt: skip

    after_b = before_b
    # Add some trailing ws to before_b
    i = 1 + before_b.find('3')
    before_b = before_b[:i] + '  ' + before_b[i:]
    self.assertNotEqual(before_b, after_b)
    self.run_test(
        before_b=before_b,
        after_b=after_b,
        before_sel=("1.0", "1.0"),
        after_sel=("1.0", "1.0"),
        command_name="clean-lines",
    )

