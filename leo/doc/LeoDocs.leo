<t tx="ekr.20261116100828.43">def openAtShadowFileForReading(self, fn: str) -&gt; str | None:  # pragma: no cover
    """Open an @shadow for reading and return shadow_fn."""
    at = self
    x = at.c.shadowController
    # readOneAtShadowNode should already have checked these.
    shadow_fn = x.shadowPathName(fn)
    shadow_exists = g.os_path_exists(shadow_fn) and g.os_path_isfile(shadow_fn)
    if not shadow_exists:
        g.trace('can not happen: no private file', shadow_fn, g.callers())
        at.error(f"can not happen: private file does not exist: {shadow_fn}")
        return None
    # This method is the gateway to the shadow algorithm.
    x.updatePublicAndPrivateFiles(at.root, fn, shadow_fn)
    return shadow_fn

</t>
<t tx="ekr.20261116100828.431">def remove_directives(self, s: str) -&gt; str:
    pattern = re.compile(r'^\s*@(\w+)\b')
    return ''.join(z for z in g.splitLines(s) if not pattern.match(z))

