<t tx="ekr.20261116100828.107">def atCleanToString(self, root: Position) -&gt; str:  # pragma: no cover
    """Write one @clean node to a string."""
    at, c = self, self.c
    c.endEditing()
    fileName = at.initWriteIvars(root)
    try:
        at.sentinels = False
        at.outputList = []
        at.putFile(root, sentinels=False)
        return '' if at.errors else ''.join(at.outputList)
    except Exception:
        at.writeException(fileName, root)
        return ''

