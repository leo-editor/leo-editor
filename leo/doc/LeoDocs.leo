<t tx="ekr.20261116100829.80">def run_test(
    self,
    before_b: str,
    after_b: str,  # before/after body text.
    before_sel: str,
    after_sel: str,  # before and after selection ranges.
    command_name: str,
    directives: str = '',
):
    """Run a test that covers one of Leo's commands."""
    c = self.c
    # self.command_name = command_name

    def toInt(s):
        return g.toPythonIndex(before_b, s)

    # Compute the result in tempNode.b
    command = c.commandsDict.get(command_name)
    assert command, f"no command: {command_name}"

    # Set the text.
    self.parent_p.b = directives
    self.tempNode.b = before_b
    self.before_p.b = before_b
    self.after_p.b = after_b

    # Set the selection range and insert point.
    w = c.frame.body.wrapper
    i, j = before_sel
    i, j = toInt(i), toInt(j)
    w.setSelectionRange(i, j, insert=j)

    # Run the command!
    event = LeoKeyEvent(c, w=w)  # Leo 6.8.9.
    c.doCommandByName(command_name, event)

    # Test the returned body text.
    w_text = w.getAllText()
    if w_text != self.tempNode.b:
        print(f"Text mismatch: {self.shortDescription()}")
        g.printObj(w_text, tag='w_text')
        g.printObj(self.tempNode.b, tag='self.tempNode.b')
        g.printObj(self.after_p.b, tag='self.after_p.b')
    self.assertEqual(w_text, self.tempNode.b, msg=command_name)

    # Test the returned selection range.
    after_i, after_j = w_sel = w.getSelectionRange()
    i = g.find_line_start(w_text, after_i)
    i_row, i_col = g.convertPythonIndexToRowCol(w_text, after_i)
    j = g.find_line_start(w_text, after_j)
    j_row, j_col = g.convertPythonIndexToRowCol(w_text, after_j)
    actual_i = f"{i_row + 1}.{i_col}"
    actual_j = f"{j_row + 1}.{j_col}"
    actual_sel = (actual_i, actual_j)
    if after_sel != actual_sel:  # Good for debugging.
        print(f"\nFAIL {g.caller():&gt;42} expected: {after_sel} got: {actual_sel}")
        g.printObj(w_text, tag='w_text')
        g.printObj(self.tempNode.b, tag='self.tempNode.b')
        g.printObj(self.after_p.b, tag='self.after_p.b')
    self.assertEqual(after_sel, actual_sel, msg=command_name)

</t>
<t tx="ekr.20261116100829.81">def test_from_BundleException_java(self):
    s = self.prep(
	"""
        /*
         * $Header: /cvs/leo/test/unitTest.leo,v 1.247 2008/02/14 14:59:04 edream Exp $
         *
         */

        package org.osgi.framework;

        public class BundleException extends Exception {
            static final long serialVersionUID = 3571095144220455665L;
            /**
             * Nested exception.
             */
            private Throwable cause;

            public BundleException(String msg, Throwable cause) {
                super(msg);
                this.cause = cause;
            }
        }
    """)  # fmt: skip

    expected_results = (
        (
            0, '',  # Ignore the first headline.
            '/*\n'
            ' * $Header: /cvs/leo/test/unitTest.leo,v 1.247 2008/02/14 14:59:04 edream Exp $\n'
            ' *\n'
            ' */\n'
            '\n'
            'package org.osgi.framework;\n'
            '\n'
            '@others\n'
            '@language java\n'
            '@tabwidth -4\n'
        ),
        (
            1, 'public class BundleException',
            'public class BundleException extends Exception {\n'
            '    @others\n'
            '}\n'
        ),
        (
            2, 'public BundleException',
            'static final long serialVersionUID = 3571095144220455665L;\n'
            '/**\n'
            ' * Nested exception.\n'
            ' */\n'
            'private Throwable cause;\n'
            '\n'
            'public BundleException(String msg, Throwable cause) {\n'
            '    super(msg);\n'
            '    this.cause = cause;\n'
            '}\n'
        ),
    )  # fmt: skip
    self.new_run_test(s, expected_results)

