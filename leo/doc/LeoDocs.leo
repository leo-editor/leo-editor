<t tx="ekr.20261116100828.1391">def onHeadlineKey(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Handle a key event in a headline."""
    if not event:
        return
    w = event.w
    ch = event.char
    # This test prevents flashing in the headline when the control key is held down.
    if ch and w:
        self.updateHead(event, w)

