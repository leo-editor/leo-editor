<t tx="ekr.20261116100828.3367">def onTextChanged(self) -&gt; None:
    """
    Update Leo after the body has been changed.

    tree.tree_select_lockout is True during the entire selection process.
    """
    # #4785: Do not delete this method. It is essential!
    w = self
    c = self.c
    p = c.p
    u = c.undoer
    tree = c.frame.tree
    if w.changingText:
        return
    if tree.tree_select_lockout:
        return
    if not p:
        return
    oldText = p.b
    if oldText == w.getAllText():
        return
    i, j = p.v.selectionStart, p.v.selectionLength
    oldSel = (i, i + j)
    u.type_text(p, oldIns=i, oldSel=oldSel, oldText=oldText, w=w)

</t>
<t tx="ekr.20261116100828.3368">def select_callback(self) -&gt; None:
    """
    Called when user selects an item in the QListWidget.
    """
    c = self.leo_c
    p = c.p
    u = c.undoer
    w = c.k.autoCompleter.w or c.frame.body.wrapper
    oldIns = w.getInsertPoint()
    oldSel = w.getSelectionRange()
    oldText = w.getAllText()
    # Replace the tail of the prefix with the completion.
    completion = self.currentItem().text()
    prefix = c.k.autoCompleter.get_autocompleter_prefix()
    parts = prefix.split('.')
    if len(parts) &gt; 1:
        tail = parts[-1]
    else:
        tail = prefix
    if tail != completion:
        j = w.getInsertPoint()
        i = j - len(tail)
        w.delete(i, j)
        w.insert(i, completion)
        j = i + len(completion)
        c.setChanged()
        w.setInsertPoint(j)
        u.type_text(p, oldIns=oldIns, oldSel=oldSel, oldText=oldText, w=w)
    self.end_completer()

