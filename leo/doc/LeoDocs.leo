<t tx="ekr.20261116100828.1147">@g.commander_command('insert-as-first-child')
def insertNodeAsFirstChild(self: Cmdr, event: LeoKeyEvent | None = None) -&gt; Position | None:
    """Insert a node as the first child of the previous node."""
    c = self
    if not c.p:
        return None
    c.endEditing()
    with c.undoer as u:
        u.set_command_name('insert-as-first-child')
        new_p = u.insert_node(c.p, as_child=True, index=0)
        u.redraw_and_edit(new_p)
        return new_p


