<t tx="ekr.20261116100828.648">def getAnyLeoFileByName(
    self,
    path: str,
    *,
    checkOpenFiles: bool = True,
    readAtFileNodesFlag: bool = True,
) -&gt; VNode | None:
    """Open any kind of Leo file."""
    c = self.c
    fc = c.fileCommands
    self.gnxDict = {}  # #1437
    if path.endswith('.db'):
        v = fc._getLeoDBFileByName(path, readAtFileNodesFlag)
    else:
        v = fc._getLeoFileByName(path, readAtFileNodesFlag)
    if v:
        c.frame.resizePanesToRatio(c.frame.compute_ratio(), c.frame.compute_secondary_ratio())
        if checkOpenFiles:
            g.app.checkForOpenFile(c, path)
    return v

