<t tx="ekr.20261116100828.1189">@cmd('center-line')
def centerLine(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Centers line within current fill column"""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    if self.fillColumn &gt; 0:
        fillColumn = self.fillColumn
    else:
        fillColumn = c.getPageWidth(c.p)
    s = w.getAllText()
    i, j = g.getLine(s, w.getInsertPoint())
    line = s[i:j].strip()
    if not line or len(line) &gt;= fillColumn:
        return
    with u.change_node(p, 'center-line'):
        n = (fillColumn - len(line)) / 2
        ws = ' ' * int(n)
        k = g.skip_ws(s, i)
        if k &gt; i:
            w.delete(i, k - i)
        w.insert(i, ws)
        p.v.b = w.getAllText()
        w.setInsertPoint(i)
        c.k.resetLabel()

</t>
<t tx="ekr.20261116100828.119"></t>
<t tx="ekr.20261116100828.1190">@cmd('center-region')
def centerRegion(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Centers the selected text within the fill column"""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    s = w.getAllText()
    sel_1, sel_2 = w.getSelectionRange()
    ind, junk = g.getLine(s, sel_1)
    junk, end = g.getLine(s, sel_2)
    if self.fillColumn &gt; 0:
        fillColumn = self.fillColumn
    else:
        fillColumn = c.getPageWidth(c.p)
    with u.change_node(p, 'center-region'):
        inserted = 0
        while ind &lt; end:
            s = w.getAllText()
            i, j = g.getLine(s, ind)
            line = s[i:j].strip()
            if len(line) &gt;= fillColumn:
                ind = j
            else:
                n = int((fillColumn - len(line)) / 2)
                inserted += n
                k = g.skip_ws(s, i)
                if k &gt; i:
                    w.delete(i, k - i)
                w.insert(i, ' ' * n)
                ind = j + n - (k - i)
        w.setSelectionRange(sel_1, sel_2 + inserted)
        p.v.b = w.getAllText()
        c.k.resetLabel()

