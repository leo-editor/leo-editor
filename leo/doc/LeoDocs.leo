<t tx="ekr.20261116100828.1193">@cmd('clean-lines')
def cleanLines(self, event: LeoKeyEvent | None = None) -&gt; None:
    """
    Removes trailing whitespace from all lines, preserving newlines.

    Not recommended: reindent is better.
    """
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    s = w.getAllText()
    lines = []
    for line in g.splitlines(s):
        if line.rstrip():
            lines.append(line.rstrip())
        if line.endswith('\n'):
            lines.append('\n')
    result = ''.join(lines)
    if s != result:
        with u.change_node(p, 'clean-lines'):
            w.delete(0, w.getLastIndex())
            w.insert(0, result)
            p.v.b = w.getAllText()
            w.setInsertPoint(0)
            c.k.resetLabel()

</t>
<t tx="ekr.20261116100828.1194">@cmd('clear-selected-text')
def clearSelectedText(self, event: LeoKeyEvent | None = None) -&gt; None:
    """Delete the selected text."""
    c = self.c
    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    i, j = w.getSelectionRange()
    if i == j:
        return
    with u.change_node(p, 'clear-selected-text'):
        w.delete(i, j)
        p.v.b = w.getAllText()
        w.setInsertPoint(i)
        c.k.resetLabel()

