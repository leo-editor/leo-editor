    p = c.p
    u = c.undoer
    w = c.frame.body.wrapper
    if not g.isTextWrapper(w):
        return
    with u.change_node(p, 'kill-paragraph'):
        self.extendToParagraph(event)
        i, j = w.getSelectionRange()
        c.killBufferCommands.killParagraphHelper(i, j)
        c.k.resetLabel()

