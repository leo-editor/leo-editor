<t tx="ekr.20261116100828.286">@g.command('show-current-layout')
def show_current_layout(event: LeoKeyEvent | None = None) -&gt; None:
    """Show the name of the current layout of Leo's outline"""
    c = event.get('c') if event else None
    if not c:
        return
    cache = c.frame.top.layout_cache
    if cache.layout_dict:
        name = cache.layout_dict.get('name', 'unnamed layout')
    else:
        name = 'unnamed layout'
    g.es(name)


