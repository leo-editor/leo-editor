<t tx="ekr.20261116100828.974">def canMoveOutlineLeft(self) -&gt; bool:
    c = self
    p = c.p
    if c.hoistStack:
        bunch = c.hoistStack[-1]
        if p and p.hasParent():
            p.moveToParent()
            return p != bunch.p and bunch.p.isAncestorOf(p)
        return False
    return bool(p and p.hasParent())

