<t tx="ekr.20261116100828.788">def firstVisible(self) -&gt; Position:
    """Move to the first visible node of the present chapter or hoist."""
    c = self
    p = c.p
    while 1:
        back = p.visBack(c)
        if back and back.isVisible(c):
            p = back
        else:
            break
    return p

