<t tx="ekr.20261116100828.169">def error(self, *args: Args) -&gt; None:  # pragma: no cover
    at = self
    at.printError(*args)
    at.errors += 1

def printError(self, *args: Args) -&gt; None:  # pragma: no cover
    """Print an error message that may contain non-ascii characters."""
    at = self
    if at.errors:
        g.error(*args)
    else:
        g.warning(*args)

