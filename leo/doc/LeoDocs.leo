<t tx="ekr.20261116100828.3363">trailing_colon_pat = re.compile(r'^.*:\s*?#.*$')  # #2230

def updateAutoIndent(self, p: Position, w: QTextMixin) -&gt; None:
    """Handle auto indentation."""
    c = self.c
    tab_width = c.getTabWidth(p)
    # Get the previous line.
    s = w.getAllText()
    ins = w.getInsertPoint()
    i = g.skip_to_start_of_line(s, ins)
    i, j = g.getLine(s, i - 1)
    s = s[i : j - 1]
    # Add the leading whitespace to the present line.
    junk, width = g.skip_leading_ws_with_indent(s, 0, tab_width)
    if s.rstrip() and (s.rstrip()[-1] == ':' or self.trailing_colon_pat.match(s)):  # 2040.
        # For Python: increase auto-indent after colons.
        if g.findLanguageDirectives(c, p) == 'python':
            width += abs(tab_width)
    if self.smartAutoIndent:
        # Determine if prev line has unclosed parens/brackets/braces
        bracketWidths = [width]
        tabex = 0
        for i, ch in enumerate(s):
            if ch == '\t':
                tabex += tab_width - 1
            if ch in '([{':
                bracketWidths.append(i + tabex + 1)
            elif ch in '}])' and len(bracketWidths) &gt; 1:
                bracketWidths.pop()
        width = bracketWidths.pop()
    if ws := g.computeLeadingWhitespace(width, tab_width):
        i = w.getInsertPoint()
        w.insert(i, ws)
        w.setInsertPoint(i + len(ws))
        w.seeInsertPoint()  # 2011/10/02: Fix cursor-movement bug.

</t>
<t tx="ekr.20261116100828.3364">def updateAutomatchBracket(
    self, p: Position, w: QTextMixin, ch: str, oldSel: tuple[int, int]
) -&gt; None:
    c = self.c
    language = c.getLanguage(p)
    i, j = oldSel
    s = w.getAllText()
    if ch in ('([{'):
        if automatch := language not in ('plain',):
            ch = ch + {'(': ')', '[': ']', '{': '}'}.get(ch, '')
        if i != j:
            w.delete(i, j)
        w.insert(i, ch)
        if automatch:
            ins = w.getInsertPoint()
            w.setInsertPoint(ins - 1)
    else:
        ins = w.getInsertPoint()
        ch2 = s[ins] if ins &lt; len(s) else ''
        if ch2 in (')', ']', '}'):
            ins = w.getInsertPoint()
            w.setInsertPoint(ins + 1)
        else:
            if i != j:
                w.delete(i, j)
            w.insert(i, ch)
            w.setInsertPoint(i + 1)

