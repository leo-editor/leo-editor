<t tx="ekr.20261116100828.269">def traceMenuTable(self, table: list) -&gt; None:
    trace = False and not g.unitTesting
    if not trace:
        return
    format = '%40s %s'
    g.trace('*' * 40)
    for data in table:
        if isinstance(data, (list, tuple)):
            n = len(data)
            if n == 2:
                print(format % (data[0], data[1]))
            elif n == 3:
                name, _, func = data
                print(format % (name, func and func.__name__ or '&lt;NO FUNC&gt;'))
        else:
            print(format % (data, ''))

